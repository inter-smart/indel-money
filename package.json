  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "analyze": "ANALYZE=true npm run build",
    "lighthouse": "lighthouse http://localhost:3000 --view --chrome-flags=\"--headless\"",
    "lighthouse-ci": "lighthouse http://localhost:3000 --output=json --output-path=./lighthouse-report.json --chrome-flags=\"--headless\"",
    "perf": "npm run build && npm run start & sleep 5 && npm run lighthouse && kill %1",
    "bundle-stats": "npx webpack-bundle-analyzer .next/static/chunks/*.js",
    "size-check": "npm run build && du -sh .next/static/chunks/*",
    "image-audit": "node scripts/image-audit.js",
    "perf-budget": "node scripts/performance-budget.js",
    "audit": "npm run analyze && npm run image-audit && npm run perf-budget"
  },
